APP_NAME=Romarr
DATABASE_URL=sqlite:///./data/romarr.db
DATA_DIR=./data
ROM_LIBRARY_PATH=./library
LOG_LEVEL=INFO

# IGDB (Twitch) credentials — https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Container user. The container runs as this uid/gid; mounted data and
# library folders must be writable by it.
PUID=1000
PGID=1000

# Comma-separated browser origins permitted for cross-origin API access.
# Empty means none, which is correct when Romarr serves its own UI.
# Example: http://localhost:5173,https://romarr.example.com
ALLOWED_ORIGINS=
